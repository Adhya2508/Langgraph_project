# Bank Customer Segmentation Agent — Environment Variables Template
# ──────────────────────────────────────────────────────────────────
# This file IS committed to source control.
# Copy it to .env and fill in your real values before running the app.
#
#   cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────

# ─── Application ────────────────────────────────────────────
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ─── Logging ────────────────────────────────────────────────
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Directories ────────────────────────────────────────────
OUTPUT_DIRECTORY=backend/outputs
UPLOAD_DIRECTORY=backend/uploads

# ─── LLM Provider ───────────────────────────────────────────
# Supported providers: mistral
LLM_PROVIDER=mistral
MODEL_NAME=mistral-small-latest
TEMPERATURE=0.2
MAX_TOKENS=2048
TOP_P=0.95

# ─── Secrets ────────────────────────────────────────────────
# Replace with your actual API key in .env (never here)
MISTRAL_API_KEY=your-mistral-api-key-here
